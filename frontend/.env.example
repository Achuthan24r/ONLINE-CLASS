# ClassOrbit Frontend Environment Configuration Template
# For local standalone development: http://localhost:5000
# For Vercel multi-service deployment (shared domain): leave blank for relative API routing
VITE_API_BASE_URL=

# LiveKit WebRTC Public WebSocket URL (e.g. wss://your-subdomain.livekit.cloud)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
