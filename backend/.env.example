# ClassOrbit Backend Environment Configuration Template
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Free Connection String
MONGODB_URI=your_mongodb_atlas_connection_string

# Session Secret (min 16 characters)
SESSION_SECRET=replace_with_a_long_random_secret

# LiveKit WebRTC Server Config
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Daily Scheduled Maintenance
CLEANUP_TIMEZONE=Asia/Kolkata
STORAGE_WARNING_THRESHOLD_MB=80
